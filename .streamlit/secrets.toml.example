# Configurações de credenciais e controle de acesso (RBAC) para Demonstração
# NUNCA versione o arquivo secrets.toml real no Git!
# No Streamlit Cloud, cadastre estas chaves em: App Settings > Secrets

[passwords]
# Hashes seguros Argon2id (gerados via utils.auth.hash_password)
# Credencial 'admin' -> senha de teste: admin123
admin = "$argon2id$v=19$m=65536,t=3,p=4$613rfQ+B8B4jJOR87x0jhA$BW0HVQHHeSoZ0kYxBXkdikn0p493A+QLVNRuow+bk+o"
# Credencial 'user' -> senha de teste: user123
user = "$argon2id$v=19$m=65536,t=3,p=4$CwGAMIYQQgghJOS8FyLEmA$+88hhzh56M/y1ZUll4vyevtRRFFhzaTinzTpM4yIbpM"

[roles]
admin = "admin"
user = "user"
